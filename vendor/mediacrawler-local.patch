+# -*- coding: utf-8 -*-
+"""COIFESP server-side auth bridge (Phase 3).
+
+通过环境变量发现 COIFESP 驱动的登录 session：
+
+    COIFESP_AUTH_SESSION_DIR=/absolute/path/to/session
+    COIFESP_AUTH_PLATFORM=weibo
+
+职责（保持小补丁，不重写任何平台登录流程）：
+- publish_qrcode(): 二维码出现时原子写 session/qr.json（不弹窗）
+- export_cookies(): 登录成功后从 BrowserContext 导出明文逻辑 cookies，
+  写 session/auth_state.json
+
+严禁把 QR / Cookie 输出到 stdout 日志；文件权限尽量 0600。
+"""
+
+import asyncio
+import json
+import os
+from datetime import datetime, timezone
+from pathlib import Path
+
+from tools import utils
+
+
+def is_coifesp_auth_session() -> bool:
+    return bool(os.environ.get("COIFESP_AUTH_SESSION_DIR"))
+
+
+def _session_dir() -> Path | None:
+    raw = os.environ.get("COIFESP_AUTH_SESSION_DIR")
+    return Path(raw) if raw else None
+
+
+def _platform() -> str:
+    return os.environ.get("COIFESP_AUTH_PLATFORM") or "unknown"
+
+
+def publish_qrcode(qr_code: str) -> None:
+    """规范化 base64 二维码并原子写 qr.json（不调用 GUI）。"""
+    session = _session_dir()
+    if session is None:
+        return
+    data_url = (
+        qr_code
+        if str(qr_code).startswith("data:")
+        else "data:image/png;base64," + str(qr_code)
+    )
+    payload = {
+        "version": 1,
+        "type": "qrcode",
+        "data_url": data_url,
+        "created_at": _now_iso(),
+    }
+    _atomic_write(session / "qr.json", json.dumps(payload, ensure_ascii=False))
+
+
+async def export_cookies(browser_context, platform: str) -> None:
+    """登录成功后导出 BrowserContext 的明文逻辑 cookies。
+
+    只写 name/value/domain/path/expires/httpOnly/secure/sameSite 等
+    Playwright 原生字段；不打印、不落日志。
+    """
+    session = _session_dir()
+    if session is None:
+        return
+    cookies = await browser_context.cookies()
+    payload = {
+        "version": 1,
+        "platform": platform,
+        "cookies": cookies,
+        "created_at": _now_iso(),
+    }
+    _atomic_write(
+        session / "auth_state.json",
+        json.dumps(payload, ensure_ascii=False),
+    )
+    utils.logger.info(
+        "[coifesp_auth_bridge] auth_state.json exported for platform %s",
+        platform,
+    )
+
+
+def _atomic_write(path: Path, text: str) -> None:
+    path.parent.mkdir(parents=True, exist_ok=True)
+    tmp = path.with_name(path.name + ".tmp")
+    tmp.write_text(text, encoding="utf-8")
+    os.replace(tmp, path)
+    try:
+        os.chmod(path, 0o600)
+    except OSError:
+        # Windows 下 chmod 不可用时容错
+        pass
+
+
+def _now_iso() -> str:
+    return datetime.now(timezone.utc).isoformat()
