diff --git a/tests/test_bilibili_resilience.py b/tests/test_bilibili_resilience.py
new file mode 100644
index 0000000..f43b659
--- /dev/null
+++ b/tests/test_bilibili_resilience.py
@@ -0,0 +1,92 @@
+from unittest.mock import AsyncMock, Mock
+
+import httpx
+import pytest
+
+from media_platform.bilibili import client as client_module
+from media_platform.bilibili.client import BilibiliClient
+from media_platform.bilibili.login import BilibiliLogin, LOGIN_ENTRY_SELECTORS
+
+
+class _AsyncClientContext:
+    def __init__(self, client):
+        self.client = client
+
+    async def __aenter__(self):
+        return self.client
+
+    async def __aexit__(self, exc_type, exc, traceback):
+        return False
+
+
+@pytest.mark.asyncio
+async def test_bilibili_request_retries_transport_error(monkeypatch):
+    request = httpx.Request("GET", "https://api.bilibili.com/test")
+    response = Mock(
+        spec=httpx.Response,
+        status_code=200,
+        headers={},
+    )
+    response.json.return_value = {"code": 0, "data": {"ok": True}}
+    http_client = Mock()
+    http_client.request = AsyncMock(
+        side_effect=[httpx.ConnectError("temporary", request=request), response]
+    )
+    monkeypatch.setattr(
+        client_module,
+        "make_async_client",
+        lambda **kwargs: _AsyncClientContext(http_client),
+    )
+    monkeypatch.setattr(client_module.asyncio, "sleep", AsyncMock())
+
+    client = BilibiliClient(
+        headers={},
+        playwright_page=AsyncMock(),
+        cookie_dict={},
+    )
+    client._refresh_proxy_if_expired = AsyncMock()
+
+    assert await client.request("GET", str(request.url)) == {"ok": True}
+    assert http_client.request.await_count == 2
+
+
+@pytest.mark.asyncio
+async def test_qrcode_login_requires_fresh_sessdata():
+    browser_context = AsyncMock()
+    browser_context.cookies = AsyncMock(
+        side_effect=[
+            [{"name": "SESSDATA", "value": "expired"}],
+            [{"name": "SESSDATA", "value": "fresh"}],
+        ]
+    )
+    login = BilibiliLogin(
+        login_type="qrcode",
+        browser_context=browser_context,
+        context_page=Mock(),
+    )
+    login._sessdata_before_qrcode = "expired"
+
+    assert await login._has_fresh_sessdata() is False
+    assert await login._has_fresh_sessdata() is True
+
+
+@pytest.mark.asyncio
+async def test_qrcode_login_clicks_current_header_entry():
+    entry = Mock()
+    entry.count = AsyncMock(return_value=1)
+    entry.nth.return_value = entry
+    entry.is_visible = AsyncMock(return_value=True)
+    entry.click = AsyncMock()
+
+    page = Mock()
+    page.locator.side_effect = lambda selector: (
+        entry if selector == LOGIN_ENTRY_SELECTORS[0] else Mock()
+    )
+    login = BilibiliLogin(
+        login_type="qrcode",
+        browser_context=AsyncMock(),
+        context_page=page,
+    )
+
+    assert await login._click_login_entry() == LOGIN_ENTRY_SELECTORS[0]
+    entry.click.assert_awaited_once_with(timeout=5_000)
