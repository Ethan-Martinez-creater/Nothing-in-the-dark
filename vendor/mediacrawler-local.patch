+def show_qrcode(qr_code) -> None:  # type: ignore
+    """parse base64 encode qrcode image and show it"""
+    # COIFESP server-side auth: 有 auth session 时把二维码导出为 qr.json，
+    # 不弹本地 GUI 窗口（headless 服务器无显示器）。
+    try:
+        from tools.coifesp_auth_bridge import (
+            is_coifesp_auth_session,
+            publish_qrcode,
+        )
+    except Exception as bridge_exc:  # noqa: BLE001 - 诊断
+        utils.logger.warning(
+            "[coifesp_auth_bridge] import failed: %s", bridge_exc
+        )
+        is_coifesp_auth_session = None
+    if is_coifesp_auth_session is not None and is_coifesp_auth_session():
+        publish_qrcode(qr_code)
+        return
+    if "," in qr_code:
+        qr_code = qr_code.split(",")[1]
+    qr_code = base64.b64decode(qr_code)
+    image = Image.open(BytesIO(qr_code))
+
+    # Add a square border around the QR code and display it within the border to improve scanning accuracy.
+    width, height = image.size
+    new_image = Image.new('RGB', (width + 20, height + 20), color=(255, 255, 255))
+    new_image.paste(image, (10, 10))
+    draw = ImageDraw.Draw(new_image)
+    draw.rectangle((0, 0, width + 19, height + 19), outline=(0, 0, 0), width=1)
+    del ImageShow.UnixViewer.options["save_all"]
+    new_image.show()
+
