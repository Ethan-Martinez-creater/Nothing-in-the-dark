# Backend
APP_ENV=development
APP_DEBUG=true
DATABASE_URL=sqlite+aiosqlite:///./data/coifesp.db
# PostgreSQL example:
# DATABASE_URL=postgresql+asyncpg://coifesp:change-me@127.0.0.1:5432/coifesp
DEMO_MODE=true
CORS_ORIGINS=["http://localhost:5173"]

# OpenAI-compatible model gateway. Secrets belong in backend/.env only.
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=
LLM_API_KEY=
LLM_FAST_MODEL=
LLM_REASONING_MODEL=
LLM_REPORT_MODEL=
LLM_MAX_CONCURRENCY=3
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=3
AGENT_MAX_TURNS=16
AGENT_MAX_TOOL_CALLS=48
AGENT_MAX_INPUT_TOKENS=120000
AGENT_MAX_OUTPUT_TOKENS=24000

# Local retrieval worker
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=auto
EMBEDDING_DIMENSIONS=1024
EMBEDDING_WORKER_URL=http://127.0.0.1:8010
EMBEDDING_TIMEOUT_SECONDS=120
RAG_DEFAULT_LIMIT=12

# Real social crawler (used only when DEMO_MODE=false)
MEDIACRAWLER_ROOT=../vendor/MediaCrawler
MEDIACRAWLER_OUTPUT_ROOT=./data/crawls
# Keep empty to use the backend virtual environment. A dedicated environment is recommended.
MEDIACRAWLER_PYTHON_EXECUTABLE=
MEDIACRAWLER_ENTRYPOINT=./scripts/mediacrawler_entry.py
MEDIACRAWLER_LOGIN_TYPE=qrcode
MEDIACRAWLER_HEADLESS=false
MEDIACRAWLER_INCLUDE_COMMENTS=true
MEDIACRAWLER_MAX_COMMENTS_PER_POST=10
MEDIACRAWLER_TIMEOUT_SECONDS=1800
MEDIACRAWLER_MAX_OUTPUT_RUNS=100
# MediaCrawler's license permits non-commercial learning/research only.
MEDIACRAWLER_USAGE_MODE=research
MEDIACRAWLER_WEIBO_COOKIES=
MEDIACRAWLER_BILIBILI_COOKIES=
MEDIACRAWLER_TIEBA_COOKIES=
MEDIACRAWLER_ZHIHU_COOKIES=
MEDIACRAWLER_DOUYIN_COOKIES=

# Frontend
VITE_API_BASE_URL=http://localhost:8000/api/v1
